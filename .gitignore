# CMake build directories
build/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Local runtime database
*.db
*.db-wal
*.db-shm

# Local operator settings (callsign, QRZ credentials)
settings.txt

# Per-SSH-user settings (see ssh_server.hpp's PerUserSettingsPath) -- same
# reasoning as settings.txt above, just one file per login user.
settings/

# SSH host key, generated on first run (see ssh_server.hpp) -- a private
# key must never be committed.
ssh_host_ed25519_key

# Downloaded FCC ULS / Census gazetteer cache
uls_cache/

# Net log / saved-station / net-slice exports (see file_export.hpp)
exports/

# Net-slice files (see net_slice.hpp) received for import
imports/

# IDE/tool-local config, not part of the project itself
.idea/
.claude/

# macOS Finder metadata
.DS_Store
