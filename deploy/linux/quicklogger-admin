#!/bin/sh
#
# Opens QuickLogger as the local console: Manage Users (Settings, F5),
# the upstream server and refreshing station data. Run it as root
# after logging in to the server's own SSH (port 2200). It runs alongside
# the SSH server, on the same database; nothing needs stopping.

cd /var/lib/quicklogger || exit 1
exec runuser -u quicklogger -- env TERM="${TERM:-xterm-256color}" HOME=/var/lib/quicklogger \
    /usr/local/bin/QuickLogger --no-ssh
