#!/bin/sh
#
# PROVIDE: quicklogger
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# QuickLogger's SSH server, run headless as the unprivileged quicklogger
# user from its data directory (the database, host key and per-user
# settings all live there). daemon(8) restarts it if it ever exits.
# Installed as /usr/local/etc/rc.d/quicklogger by setup.sh.
#
# rc.conf settings:
#   quicklogger_enable="YES"
#   quicklogger_port="22"         (the port users ssh to)
#   quicklogger_dir="/var/db/quicklogger"

. /etc/rc.subr

name=quicklogger
rcvar=quicklogger_enable

load_rc_config $name

: ${quicklogger_enable:="NO"}
: ${quicklogger_user:="quicklogger"}
: ${quicklogger_dir:="/var/db/quicklogger"}
: ${quicklogger_port:="22"}

quicklogger_chdir="${quicklogger_dir}"
# Started at boot, rc gives services only /sbin:/bin:/usr/sbin:/usr/bin,
# but sz and rz (lrzsz, for ZMODEM) are in /usr/local/bin.
quicklogger_env="PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
# rc.subr starts daemon(8) as quicklogger_user (daemon's own -u fails to
# set up that user's environment), so its pidfile goes in a directory that
# user owns.
pidfile="/var/run/${name}/${name}.pid"
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
# -f: daemon and QuickLogger start with stdin/stdout/stderr on /dev/null
# (-o still sends QuickLogger's output to the log), so nothing holds the
# terminal of whoever ran `service quicklogger start` -- an ssh that ran it
# would otherwise wait for every QuickLogger process to exit.
command_args="-f -r -R 5 -P ${pidfile} -o /var/log/quicklogger.log -t ${name} /usr/local/bin/QuickLogger --headless --ssh-port=${quicklogger_port}"

start_precmd="${name}_prestart"
stop_cmd="${name}_stop"

quicklogger_prestart()
{
    install -d -o "${quicklogger_user}" -m 755 "/var/run/${name}"
}

# daemon(8) doesn't exit until everything holding its log pipe has gone,
# and every SSH connection's process holds it -- so stopping only daemon
# (rc.subr's default) waits as long as anyone stays connected. Stops
# them all instead: daemon first, so it doesn't restart anything.
quicklogger_stop()
{
    rc_pid=$(check_pidfile "${pidfile}" "${procname}")
    if [ -z "${rc_pid}" ]; then
        echo "${name} not running? (check ${pidfile})."
        return 1
    fi
    echo "Stopping ${name}."
    kill -TERM "${rc_pid}"
    pkill -TERM -U "${quicklogger_user}" QuickLogger
    wait_for_pids "${rc_pid}"
}

run_rc_command "$1"
